# SiliconFlow — https://cloud.siliconflow.cn/ → API Keys
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Defaults (override as needed)
SILICONFLOW_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
SILICONFLOW_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:bella

# LiveKit (same as services/rtc/etc/rtc.yaml)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=suim
LIVEKIT_API_SECRET=

# Redis dispatch from rtc
REDIS_URL=redis://:PASSWORD@127.0.0.1:6379/0
AGENT_STREAM=suim:agent:dispatch
AGENT_GROUP=suim-agent-workers
