# Copy to .env. Do not commit .env.
OPENAI_API_KEY=
# SiliconFlow:
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_STT_MODEL=FunAudioLLM/SenseVoiceSmall
# SenseVoice: keep detect language on (omit language=)
OPENAI_STT_DETECT_LANGUAGE=1
# AGENT_TTS_VOICE=zh-CN-XiaoxiaoNeural
# AGENT_GREETING=你好，我是 SuIM 语音助手。有什么可以帮你？

# Moss-Live Path B duplex (defaults are fine for local)
# AGENT_TURN_DETECTOR=1
# AGENT_TURN_DETECTOR_VERSION=v1-mini
# AGENT_INTERRUPTION_MODE=adaptive
# AGENT_ENDPOINTING_MODE=dynamic
# AGENT_MIN_ENDPOINTING_DELAY=0.35
# AGENT_MAX_ENDPOINTING_DELAY=2.5
# AGENT_MIN_INTERRUPTION_DURATION=0.35
# AGENT_FALSE_INTERRUPTION_TIMEOUT=1.5

# Moss TTS（有 Key 时优先于 edge-tts）
