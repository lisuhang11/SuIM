listenIP: 0.0.0.0
registerIP: 127.0.0.1
port: 8083

mysql:
  address:
    - 127.0.0.1:3306
  username: suim
  password: ""
  database: suim
  maxOpenConn: 20
  maxIdleConn: 10

redis:
  address:
    - 127.0.0.1:6379
  username: ""
  password: ""
  redisMode: standalone
  db: 0
  maxRetry: 3
  poolSize: 10

localCache:
  topic: suim:group:cache:delete
  slotNum: 100
  slotSize: 2000
  successExpire: 300
  failedExpire: 5

registry:
  type: etcd
  etcd:
    endpoints:
      - 127.0.0.1:2379
    rootDir: /services
    username: ""
    password: ""
    dialTimeout: 5
    ttl: 10
